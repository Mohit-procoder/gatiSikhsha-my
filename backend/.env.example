FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production
JWT_SECRET_KEY=change_this_to_a_random_secure_jwt_key_in_production

# MongoDB Atlas Connection URI format:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.xxxx.mongodb.net/afip_database?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/afip_database

# Production frontend URL (e.g. https://your-frontend.vercel.app)
FRONTEND_URL=http://localhost:5173

